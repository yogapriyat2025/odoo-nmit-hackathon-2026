<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="rule_dayflow_employee_own"
            model="ir.rule">

        <field name="name">
            Employee can view own employee record
        </field>

        <field name="model_id"
               ref="hr.model_hr_employee"/>

        <field name="groups"
               eval="[(4, ref('dayflow_core.group_dayflow_employee'))]"/>

        <field name="domain_force">
            [('user_id', '=', user.id)]
        </field>

        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>

    </record>

</odoo>