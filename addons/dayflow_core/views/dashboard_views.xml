<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_dayflow_dashboard_tree" model="ir.ui.view">

        <field name="name">dayflow.dashboard.tree</field>

        <field name="model">dayflow.dashboard</field>

        <field name="arch" type="xml">

            <list string="Dashboard">

                <field name="name"/>
                <field name="description"/>

            </list>

        </field>

    </record>


    <record id="view_dayflow_dashboard_form" model="ir.ui.view">

        <field name="name">dayflow.dashboard.form</field>

        <field name="model">dayflow.dashboard</field>

        <field name="arch" type="xml">

            <form string="Dayflow Dashboard">

                <sheet>

                    <group>

                        <field name="name"/>

                        <field name="description"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <record id="action_dayflow_dashboard"
            model="ir.actions.act_window">

        <field name="name">Dashboard</field>

        <field name="res_model">dayflow.dashboard</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>