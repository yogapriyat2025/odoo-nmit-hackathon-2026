<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_dayflow_leave_tree"
            model="ir.ui.view">

        <field name="name">dayflow.leave.tree</field>

        <field name="model">dayflow.leave</field>

        <field name="arch" type="xml">

            <list string="Leave Requests">

                <field name="name"/>
                <field name="employee_id"/>
                <field name="leave_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days"/>
                <field name="state"/>

            </list>

        </field>

    </record>


    <record id="view_dayflow_leave_form"
            model="ir.ui.view">

        <field name="name">dayflow.leave.form</field>

        <field name="model">dayflow.leave</field>

        <field name="arch" type="xml">

            <form string="Leave Request">

                <header>

                    <button
                        name="action_approve"
                        string="Approve"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'pending'"
                    />

                    <button
                        name="action_reject"
                        string="Reject"
                        type="object"
                        class="btn-danger"
                        invisible="state != 'pending'"
                    />

                    <button
                        name="action_reset"
                        string="Reset"
                        type="object"
                        invisible="state == 'pending'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="pending,approved,rejected"
                    />

                </header>

                <sheet>

                    <group>

                        <group>

                            <field name="name"
                                   readonly="1"/>

                            <field name="employee_id"/>

                            <field name="leave_type"/>

                        </group>

                        <group>

                            <field name="start_date"/>

                            <field name="end_date"/>

                            <field name="days"
                                   readonly="1"/>

                        </group>

                    </group>

                    <group>

                        <field name="remarks"/>

                        <field name="manager_comment"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <record id="view_dayflow_leave_search"
            model="ir.ui.view">

        <field name="name">dayflow.leave.search</field>

        <field name="model">dayflow.leave</field>

        <field name="arch" type="xml">

            <search>

                <field name="employee_id"/>
                <field name="leave_type"/>
                <field name="state"/>

                <filter
                    name="pending"
                    string="Pending"
                    domain="[('state','=','pending')]"
                />

                <filter
                    name="approved"
                    string="Approved"
                    domain="[('state','=','approved')]"
                />

                <filter
                    name="rejected"
                    string="Rejected"
                    domain="[('state','=','rejected')]"
                />

            </search>

        </field>

    </record>


    <record id="action_dayflow_leave"
            model="ir.actions.act_window">

        <field name="name">Leave Requests</field>

        <field name="res_model">dayflow.leave</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>