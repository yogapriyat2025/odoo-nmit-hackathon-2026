<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_dayflow_payroll_tree"
            model="ir.ui.view">

        <field name="name">dayflow.payroll.tree</field>

        <field name="model">dayflow.payroll</field>

        <field name="arch" type="xml">

            <list string="Payroll">

                <field name="name"/>
                <field name="employee_id"/>
                <field name="month"/>
                <field name="year"/>
                <field name="basic_salary"/>
                <field name="allowance"/>
                <field name="deduction"/>
                <field name="leave_deduction"/>
                <field name="net_salary"/>
                <field name="state"/>

            </list>

        </field>

    </record>


    <record id="view_dayflow_payroll_form"
            model="ir.ui.view">

        <field name="name">dayflow.payroll.form</field>

        <field name="model">dayflow.payroll</field>

        <field name="arch" type="xml">

            <form string="Payroll">

                <header>

                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_paid"
                        string="Mark as Paid"
                        type="object"
                        class="btn-success"
                        invisible="state != 'confirmed'"
                    />

                    <button
                        name="action_reset"
                        string="Reset"
                        type="object"
                        invisible="state == 'draft'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,paid"
                    />

                </header>

                <sheet>

                    <group>

                        <group>

                            <field name="name"
                                   readonly="1"/>

                            <field name="employee_id"/>

                            <field name="month"/>

                            <field name="year"/>

                        </group>

                        <group>

                            <field name="basic_salary"/>

                            <field name="allowance"/>

                            <field name="deduction"/>

                            <field name="leave_deduction"/>

                        </group>

                    </group>

                    <separator string="Salary Summary"/>

                    <group>

                        <field name="net_salary"
                               readonly="1"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <record id="action_dayflow_payroll"
            model="ir.actions.act_window">

        <field name="name">Payroll</field>

        <field name="res_model">dayflow.payroll</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>