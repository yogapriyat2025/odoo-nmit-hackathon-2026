<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- EMPLOYEE CAN SEE OWN LEAVE -->

    <record id="rule_dayflow_leave_employee"
            model="ir.rule">

        <field name="name">
            Employee Own Leave
        </field>

        <field name="model_id"
               ref="model_dayflow_leave"/>

        <field name="groups"
               eval="[(4, ref('dayflow_core.group_dayflow_employee'))]"/>

        <field name="domain_force">
            [('employee_id.user_id', '=', user.id)]
        </field>

        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>

    </record>


    <!-- HR CAN SEE ALL LEAVE -->

    <record id="rule_dayflow_leave_hr"
            model="ir.rule">

        <field name="name">
            HR All Leave
        </field>

        <field name="model_id"
               ref="model_dayflow_leave"/>

        <field name="groups"
               eval="[(4, ref('dayflow_core.group_dayflow_hr'))]"/>

        <field name="domain_force">
            [(1, '=', 1)]
        </field>

        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>

    </record>


    <!-- EMPLOYEE CAN VIEW OWN PAYROLL -->

    <record id="rule_dayflow_payroll_employee"
            model="ir.rule">

        <field name="name">
            Employee Own Payroll
        </field>

        <field name="model_id"
               ref="model_dayflow_payroll"/>

        <field name="groups"
               eval="[(4, ref('dayflow_core.group_dayflow_employee'))]"/>

        <field name="domain_force">
            [('employee_id.user_id', '=', user.id)]
        </field>

        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>

    </record>


    <!-- HR CAN CONTROL ALL PAYROLL -->

    <record id="rule_dayflow_payroll_hr"
            model="ir.rule">

        <field name="name">
            HR All Payroll
        </field>

        <field name="model_id"
               ref="model_dayflow_payroll"/>

        <field name="groups"
               eval="[(4, ref('dayflow_core.group_dayflow_hr'))]"/>

        <field name="domain_force">
            [(1, '=', 1)]
        </field>

        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>

    </record>

</odoo>