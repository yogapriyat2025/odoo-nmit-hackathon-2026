<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="rule_dayflow_attendance_employee"
            model="ir.rule">

        <field name="name">
            Employee Own Attendance
        </field>

        <field name="model_id"
               ref="model_dayflow_attendance"/>

        <field name="groups"
               eval="[(4, ref('dayflow_core.group_dayflow_employee'))]"/>

        <field name="domain_force">
            [('employee_id.user_id', '=', user.id)]
        </field>

        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>

    </record>


    <record id="rule_dayflow_attendance_hr"
            model="ir.rule">

        <field name="name">
            HR All Attendance
        </field>

        <field name="model_id"
               ref="model_dayflow_attendance"/>

        <field name="groups"
               eval="[(4, ref('dayflow_core.group_dayflow_hr'))]"/>

        <field name="domain_force">
            [(1, '=', 1)]
        </field>

        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>

    </record>

</odoo>